define page page_metadata using title_text
    give std_ui_widget("head", {}, [
        std_ui_widget("title", {}, [title_text]),
        std_ui_widget("link", {"rel": "stylesheet", "href": "/static/style.css?v=0.6.1"}, []),
        std_ui_widget("meta", {"charset": "utf-8"}, []),
        std_ui_widget("meta", {"name": "viewport", "content": "width=device-width, initial-scale=1.0"}, [])
    ])

define page landing_page_metadata using title_text
    give std_ui_widget("head", {}, [
        std_ui_widget("title", {}, [title_text]),
        std_ui_widget("link", {"rel": "stylesheet", "href": "/static/style.css?v=0.6.1"}, []),
        std_ui_widget("meta", {"charset": "utf-8"}, []),
        std_ui_widget("meta", {"name": "viewport", "content": "width=device-width, initial-scale=1.0"}, []),
        std_ui_widget("script", {"type": "application/ld+json"}, [
            '{"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "shlcpp", "applicationCategory": "DeveloperApplication", "operatingSystem": "Cross-platform", "url": "https://shelllite.tech", "author": { "@type": "Person", "name": "Shrey Naithani", "url": "https://shreyn.tech" }, "description": "A programming language with pseudocode-like syntax, designed for human readability.", "license": "https://www.gnu.org/licenses/gpl-3.0.html", "softwareVersion": "0.1.0", "offers": { "@type": "Offer", "price": "0.00", "priceCurrency": "USD" }, "codeRepository": "https://github.com/ShellLite/shlcpp"}'
        ])
    ])

define page global_navigation using
    give std_ui_widget("header", {}, [
        std_ui_widget("div", {"class": "container"}, [
            std_ui_widget("nav", {}, [
                std_ui_widget("div", {"class": "logo"}, ["shlcpp"]),
                std_ui_widget("div", {"class": "nav-links"}, [
                    std_ui_widget("a", {"href": "/"}, ["Home"]),
                    std_ui_widget("a", {"href": "/compiler"}, ["Compiler"]),
                    std_ui_widget("a", {"href": "/docs/Changelog.md"}, ["Changelog"]),
                    std_ui_widget("a", {"href": "/contact"}, ["Contact"]),
                    std_ui_widget("a", {"href": "https://github.com/ShellLite/shlcpp"}, ["GitHub"])
                ])
            ])
        ])
    ])

define page universal_footer using
    give std_ui_widget("footer", {}, [
        std_ui_widget("div", {"class": "container"}, [
            std_ui_widget("p", {}, [
                std_ui_widget("span", {}, ["This website was written using "]),
                std_ui_widget("strong", {}, ["shlcpp."]),
                std_ui_widget("span", {"style": "font-style: italic; color: #60a5fa;"}, [" Code like you think!"])
            ]),
            std_ui_widget("p", {"style": "font-size: 0.8em; margin-top: 10px;"}, ["© 2025-Present Shrey Naithani"])
        ])
    ])

use "compiler_v2.shl"

define page landing_page using
    give std_ui_widget("html", {}, [
        landing_page_metadata("shlcpp - Code like you think"),
        std_ui_widget("body", {}, [
            global_navigation(),
            std_ui_widget("div", {"class": "hero"}, [
                std_ui_widget("div", {"class": "container"}, [
                    std_ui_widget("h1", {}, ["Code like you think."]),
                    std_ui_widget("p", {"class": "tagline"}, ["shlcpp is a programming language designed to be as readable as plain English :)"]),
                    std_ui_widget("div", {"class": "action-buttons"}, [
                        std_ui_widget("a", {"href": "/compiler", "class": "btn btn-primary"}, ["Try Online Compiler"]),
                        std_ui_widget("a", {"href": "https://github.com/ShellLite/shlcpp/releases/latest", "class": "btn btn-outline"}, ["Download shlcpp"])
                    ])
                ])
            ]),
            universal_footer()
        ])
    ])

define page document_reader using
    give std_ui_widget("html", {}, [
        std_ui_widget("head", {}, [
            std_ui_widget("title", {}, ["Changelog - shlcpp"]),
            std_ui_widget("link", {"rel": "stylesheet", "href": "/static/style.css?v=0.6.1"}, []),
            std_ui_widget("link", {"rel": "stylesheet", "href": "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css"}, []),
            std_ui_widget("script", {"src": "https://cdn.jsdelivr.net/npm/marked/marked.min.js"}, []),
            std_ui_widget("script", {"src": "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"}, []),
            std_ui_widget("script", {"src": "/static/doc_viewer.js"}, [])
        ]),
        std_ui_widget("body", {}, [
            global_navigation(),
            std_ui_widget("div", {"class": "container"}, [
                std_ui_widget("div", {"class": "docs-layout", "style": "display: block;"}, [
                    std_ui_widget("div", {"class": "docs-main", "style": "width: 100%;"}, [
                        std_ui_widget("div", {"id": "content", "class": "docs-content markdown-body"}, [
                            std_ui_widget("h1", {}, ["Opening document..."]),
                            std_ui_widget("p", {}, ["Please wait while we fetch the contents."])
                        ])
                    ])
                ])
            ]),
            universal_footer()
        ])
    ])

define page contact_page using
    give std_ui_widget("html", {}, [
        page_metadata("Contact - shlcpp"),
        std_ui_widget("body", {}, [
            global_navigation(),
            std_ui_widget("div", {"class": "container", "style": "padding-top: 60px; min-height: 70vh;"}, [
                std_ui_widget("div", {"class": "card", "style": "max-width: 700px; margin: 0 auto; text-align: center;"}, [
                    std_ui_widget("h1", {}, ["Have questions? We are here to help :)"]),
                    std_ui_widget("div", {"style": "margin-top: 40px; text-align: left;"}, [
                        std_ui_widget("p", {}, [
                            std_ui_widget("strong", {}, ["Email: "]),
                            std_ui_widget("span", {}, ["contact@shelllite.tech"])
                        ]),
                        std_ui_widget("p", {}, [
                            std_ui_widget("strong", {}, ["GitHub: "]),
                            std_ui_widget("a", {"href": "https://github.com/ShellLite/shlcpp/issues"}, ["Report a bug or request a feature"])
                        ])
                    ])
                ])
            ]),
            universal_footer()
        ])
    ])

to landing_handler(req)
    give "<!DOCTYPE html>" + landing_page()

to docs_handler(req)
    give "<!DOCTYPE html>" + document_reader()

to contact_handler(req)
    give "<!DOCTYPE html>" + contact_page()

std_web_on_request("get", "/", landing_handler)
std_web_on_request("get", "/docs/:file", docs_handler)
std_web_on_request("get", "/contact", contact_handler)
std_web_serve_static("/static", "public")
std_web_listen(8080, "0.0.0.0")

to keepalive()
    pass = 1

std_nlp_every(60, "seconds", keepalive)

say "starting shlcpp website on port 8080"
